  "scripts": {
    "quitar_freno": [
      {"face": "right"},
      "¡Ñiiiec! Qué duro está...",
      {"hide": "freno"},
      {"set": "freno_quitado"},
      "¡Ya está! Freno quitado."
    ],
    "empujar_mesa": [
      {"if": "state:mesa=movida", "then": "Ya la he movido bastante.", "else": [
        {"if": "!freno_quitado",
         "then": ["No se mueve ni un milímetro.", "Ah, claro: tiene un freno echado en una pata."],
         "else": [
           {"face": "right"},
           "¡Aaaarrgh!",
           {"move": ["mesa", 100, 0, 2], "withPlayer": true},
           {"state": ["mesa", "movida"]},
           {"set": "mesa_movida"},
           {"face": "left"},
           "¡Anda! Debajo había una alfombra."
         ]}
      ]}
    ],
    "quitar_alfombra": [
      {"if": "!mesa_movida", "then": "No puedo, la mesa de billar está encima.", "else": [
        {"if": "state:alfombra_mesa=enrollada", "then": "Ya la he quitado.", "else": [
          {"state": ["alfombra_mesa", "enrollada"]},
          {"show": "trampilla"},
          "¡Una trampilla! Esto se pone interesante."
        ]}
      ]}
    ],
    "bolsillo": [
      {"if": "!nota_cogida",
       "then": ["Hay un papel en el bolsillo del abrigo.", {"pickup": "nota"}, {"set": "nota_cogida"}, "Me lo quedo."],
       "else": "Solo pelusa y un caramelo de 1953."}
    ],
    "leer_nota": [
      "Dice así:",
      "Guardé la llave del portón en el sótano, colgada de la viga.",
      "La entrada al sótano está bajo la mesa de billar.",
      "Firmado: el mayordomo.",
      "P.D.: quiten el freno antes de mover la mesa."
    ]
  },

